{
  "expo": {
    "name": "CERP Emergency Alert System",
    "slug": "sos-app",
    "scheme": "sosapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cerp.emergency",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CERP requires GPS location to broadcast your emergency coordinates and calculate road routes for emergency responders."
      }
    },
    "android": {
      "package": "com.cerp.emergency",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CERP Emergency Alert System to access your GPS location for emergency response dispatch and routing."
        }
      ]
    ]
  }
}
