# ==============================================================================
# React Native / Expo Frontend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local in frontend/sos-app/
# Replace <YOUR_LAPTOP_IP> with your development machine's local IPv4 Wi-Fi address (e.g., 192.168.1.15)
# Note: For physical devices running Expo Go, use your Wi-Fi LAN IP address, NOT localhost.

EXPO_PUBLIC_API_URL=http://<YOUR_LAPTOP_IP>:8000
