# ==============================================================================
# Django Emergency Response Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the same directory (backend/.env) and configure values.

# --- Security & Django Settings ---
SECRET_KEY=django-insecure-change-this-key-for-production-use
DEBUG=True
ALLOWED_HOSTS=*
FRONTEND_BASE_URL=http://localhost:8000

# --- Database Configuration (PostgreSQL) ---
# Option A: Individual credentials (Default local setup)
DB_NAME=emergency_response_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Option B: Database URL (Optional - if set, overrides individual DB_* settings above)
# DATABASE_URL=postgres://postgres:password@localhost:5432/emergency_response_db

# --- Email / SMTP Settings ---
# For local development without real email credentials, use console backend:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
EMAIL_TIMEOUT=10

# --- Celery & Redis Settings ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Twilio SMS Settings (Optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Firebase Service Account (Optional) ---
# Place your firebase-credentials.json file in the backend/ root folder if push notifications are needed.
# If absent, Firebase push notifications are safely disabled and Django runs normally.
